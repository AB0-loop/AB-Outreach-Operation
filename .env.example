# ---------------------------------------------------------------------------
# Aurum Bespoke — Autonomous Outreach System
# Copy to .env and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Core -----------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/aurum
APP_BASE_URL=https://outreach.aurumbespoke.com

# Dashboard authentication ---------------------------------------------------
ADMIN_USERNAME=aurum
ADMIN_PASSWORD=
# openssl rand -base64 48
SESSION_SECRET=
# 32 bytes, hex or base64:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Gmail OAuth (Google Cloud Console → OAuth client, type "Web application") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://outreach.aurumbespoke.com/api/oauth/gmail/callback
# Optional Gmail push notifications (Pub/Sub). Polling is used when unset.
GMAIL_PUBSUB_TOPIC=projects/<project-id>/topics/<topic>
# Shared secret appended to the Pub/Sub push endpoint URL (?token=...)
GMAIL_PUSH_SECRET=

# xAI Grok — PRIMARY AI provider ---------------------------------------------
# A consumer Grok / X Premium subscription is NOT API credit. Fund the
# developer account at console.x.ai before enabling AI-dependent work.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Google Gemini — SECONDARY / automatic failover ------------------------------
# Gemini is NOT assumed to be free. Failover is capped by Gemini's own daily
# budget (geminiDailyCapUsd in settings) as well as the combined ceiling.
# Leave blank to run Grok-only: the system then uses the deterministic approved
# template whenever Grok is unavailable, rather than switching to a paid API.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Telegram -------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Passed to setWebhook as secret_token; verified on every update.
TELEGRAM_WEBHOOK_SECRET=

# Operations -----------------------------------------------------------------
# Shared secret for POST /api/cron when an external scheduler drives the loop.
CRON_SECRET=
# 1 = replace Gmail/Telegram/Grok/Gemini with in-memory fakes (dry runs + tests).
OUTREACH_MOCK=0
# 0 = disable the in-process scheduler and drive /api/cron externally.
SCHEDULER_ENABLED=1
SCHEDULER_INTERVAL_MS=30000
